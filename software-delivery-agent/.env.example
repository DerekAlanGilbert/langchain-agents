# Copy to .env and fill in real values. Names only — never commit secrets.

# --- Managed runtime / model -------------------------------------------------
# LangSmith API key; `mda deploy` uses it and forwards provider keys as
# deployment secrets.
LANGSMITH_API_KEY=
# The agent's model is anthropic:claude-sonnet-5.
ANTHROPIC_API_KEY=

# --- Remote MCP connectors ---------------------------------------------------
# Pre-provisioned OAuth 2.1 access token for the official Atlassian remote MCP
# server (Jira + Confluence). MDA cannot run an interactive OAuth flow, and an
# Atlassian API token is NOT interchangeable with this access token.
ATLASSIAN_MCP_ACCESS_TOKEN=
# Pre-provisioned access token for the Slack remote MCP server.
SLACK_MCP_ACCESS_TOKEN=
# Pre-provisioned access token for the Sentry remote MCP server.
SENTRY_MCP_ACCESS_TOKEN=
# Optional. Override to scope Sentry MCP to an org/project path, e.g.
# https://mcp.sentry.dev/mcp/<org-slug> — leave empty for the default.
SENTRY_MCP_URL=

# --- Sandbox / GitHub (gh CLI only; GitHub is not an MCP connector) ----------
# Least-privilege fine-grained PAT or GitHub App installation token scoped to
# DELIVERY_REPOSITORY: contents read/write + pull requests write. Used only
# for gh auth, branch push, and draft PRs inside the sandbox.
GH_TOKEN=
# owner/repo the implementation schedule works on.
DELIVERY_REPOSITORY=
# Optional Browser Use Cloud key for UI reproduction in the sandbox.
BROWSER_USE_API_KEY=

# --- Workflow configuration --------------------------------------------------
JIRA_PROJECT_KEY=ENG
# Label a human adds in Jira to authorize implementation. Default: agent-ready.
JIRA_READY_LABEL=agent-ready
# Slack channel ID for triage and implementation summaries.
SLACK_CHANNEL_ID=
