# --- Model ---
# Optional. Default is anthropic:claude-sonnet-5.
AGENT_MODEL=anthropic:claude-sonnet-5

# --- Sentry ---
# Organization auth token with org:read and event:read scopes.
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=your-sentry-org-slug
# Optional. Comma-separated numeric project IDs to filter triage to.
SENTRY_PROJECTS=
# Optional. Override for self-hosted Sentry.
SENTRY_BASE_URL=https://sentry.io

# --- Atlassian (Jira + Confluence, same site and token) ---
ATLASSIAN_BASE_URL=https://your-workspace.atlassian.net
ATLASSIAN_EMAIL=bot@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token
JIRA_PROJECT_KEY=ENG
# Optional. Label a human adds to authorize implementation. Default: agent-ready.
JIRA_READY_LABEL=agent-ready

# --- Slack ---
# Bot token (xoxb-...) with chat:write; search.messages additionally needs
# a user token with search:read if you enable Slack search.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SUMMARY_CHANNEL=#eng-triage
SLACK_SIGNING_SECRET=your-slack-signing-secret

# --- Sandbox / delivery repository (used inside the managed sandbox) ---
# owner/repo the implementation schedule works on.
DELIVERY_REPOSITORY=your-org/your-app
# Fine-grained PAT or GitHub App installation token. Least privilege:
# contents:read/write + pull_requests:write on DELIVERY_REPOSITORY only.
GH_TOKEN=your-github-token

# --- Browser Use (optional, for headless browser reproduction) ---
BROWSER_USE_API_KEY=
# Or point Browser Use at an external CDP endpoint instead of the cloud:
BU_CDP_URL=
BU_CDP_WS=

# --- LangSmith (managed runtime / sandbox) ---
LANGSMITH_API_KEY=your-langsmith-api-key
