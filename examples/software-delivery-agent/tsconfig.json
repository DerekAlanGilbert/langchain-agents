{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node"]
  },
  "include": [
    "agent.ts",
    "identity.ts",
    "channels/**/*.ts",
    "connectors/**/*.ts",
    "schedules/**/*.ts",
    "sandbox/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
